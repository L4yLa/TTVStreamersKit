<Project>

  <!--
    BeatSaberDir はここで定義しない。BeatSaberModdingTools.Tasks、環境変数、TTVStreamersKit.csproj.user が
    解決する。ここに既定値を書くと、それらの結果を上書きしてしまう。
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>TTVStreamersKit</AssemblyName>
    <RootNamespace>TTVStreamersKit</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>L4yLa</Authors>
    <Product>TTVStreamersKit</Product>
    <Configurations>Debug;Release</Configurations>
    <!-- 対象のゲームの版は Platform（BS1.40.8 / BS1.44.1）で選ぶ。 -->
    <Platforms>BS1.40.8;BS1.44.1</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <!--
    BSTarget は Platform から決まり、未指定なら 1.40.8。restore の結果と中間ファイルを版ごとに分けるため、
    SDK の読み込みより前に評価されるこのファイルで出力先を設定する。
  -->
  <PropertyGroup>
    <BSTarget Condition="'$(BSTarget)' == '' AND '$(Platform)' == 'BS1.44.1'">1.44.1</BSTarget>
    <BSTarget Condition="'$(BSTarget)' == ''">1.40.8</BSTarget>
    <BaseIntermediateOutputPath>obj\$(BSTarget)\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\$(BSTarget)\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <BSMTProjectType>BSIPA</BSMTProjectType>
    <DisableCopyToGame>true</DisableCopyToGame>
    <DisableZipRelease>true</DisableZipRelease>
  </PropertyGroup>

</Project>
