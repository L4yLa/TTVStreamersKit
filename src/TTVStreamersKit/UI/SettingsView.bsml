<vertical child-control-height='false' child-expand-height='false' spacing='2' pad='4' preferred-width='110' vertical-fit='PreferredSize'>
  <dropdown-list-setting text='Language / 言語' value='language' choices='languages' apply-on-change='true'
                         hover-hint='{{Applies to the UI and chat replies. Reopen a screen to see the change|UI とチャットへの返信の言語です 開き直した画面から切り替わります}}' />
  <toggle-setting text='{{Chat|チャット機能}}' value='chat-enabled' apply-on-change='true'
                  hover-hint='{{Shows the chat in the world|空間にチャットを表示します}}' />
  <toggle-setting text='{{Song requests|リクエスト機能}}' value='request-enabled' apply-on-change='true'
                  hover-hint='{{Accepts song requests from the chat|チャットからの曲のリクエストを受け付けます}}' />
  <toggle-setting text='{{Emote effects|エモート演出機能}}' value='emotes-enabled' apply-on-change='true'
                  hover-hint='{{Rains chat emotes in the world|チャットのエモートを空間に降らせます}}' />
  <dropdown-list-setting text='{{Chat visible on|チャットの表示対象}}' value='layer-type' choices='layer-types' formatter='layer-formatter' apply-on-change='true' bind-value='true'
                         hover-hint='{{Hide on desktop shows the chat only in the headset|デスクトップ非表示にするとヘッドセットの中だけに表示します}}' />
</vertical>
